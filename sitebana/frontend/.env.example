# ============================================================
#  SITEBANA — Environment Variables
#  Copy this file to .env and fill in your real values
# ============================================================

# ─── SUPABASE ─────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API

# Frontend (safe to expose in browser)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend ONLY — never expose this to the frontend
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── RAZORPAY ─────────────────────────────────────────────────
# Get these from: https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_...) during development
# Switch to LIVE keys (rzp_live_...) before launch

RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret — from Razorpay Dashboard → Webhooks → Add Webhook
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Frontend — the publishable key (safe for browser)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX

# ─── ANTHROPIC ────────────────────────────────────────────────
# Get from: https://console.anthropic.com/keys
# Keep this SERVER-SIDE ONLY — never put in Vite frontend

ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── APP ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Your deployed frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# In production: FRONTEND_URL=https://sitebana.in

# ─── OPTIONAL: EMAIL (for booking confirmations) ──────────────
# Supabase handles transactional email via its built-in SMTP
# Or use Resend: https://resend.com
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=noreply@sitebana.in
